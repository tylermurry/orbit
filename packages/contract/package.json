{
  "name": "@orbit/contract",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./schema/orbit.schema.json",
    "./dist": "./dist/index.js"
  },
  "scripts": {
    "build": "node scripts/gen-validator.mjs --check && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/gen-validator.mjs --check && vitest run",
    "gen": "node scripts/gen-validator.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "jsonc-parser": "3.3.1"
  }
}
